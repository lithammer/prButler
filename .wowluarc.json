{
    "flavors": ["forever"],
    "diagnostics": {
        "enable": [
            "implicit-nil-return",
            "incomplete-signature-doc",
            "invalid-op",
            "missing-param-annotation",
            "missing-return-annotation",
            "need-check-nil",
            "nil-index",
            "redundant-and",
            "redundant-condition",
            "redundant-or",
            "unknown-callback-event",
            "unused-function",
            "unused-vararg"
        ]
    }
}
